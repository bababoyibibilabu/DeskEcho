# ================= DeskEcho Configuration =================

# ----------------- 1. 大模型 (LLM) 配置 -----------------
# 兼容 OpenAI 协议 (可使用阿里云通义千问、DeepSeek、OpenAI 等)
OPENAI_API_KEY=your_llm_api_key_here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ----------------- 2. 语音识别 (ASR) 配置 -----------------
# 语音识别提供商选择: volcengine (火山引擎) | dashscope (阿里) | openai (Whisper)
ASR_PROVIDER=volcengine

# [火山引擎 Volcengine 语音识别配置]
VOLC_APPID=your_volc_appid
VOLC_ACCESS_TOKEN=your_volc_access_token
VOLC_CLUSTER=volcengine_input_common

# [阿里 DashScope 通义听悟 / SenseVoice 配置]
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# ----------------- 3. 全局对讲热键与语音播报 (TTS) -----------------
INTERCOM_KEY=Alt_R
ENABLE_TTS=true
TTS_PROVIDER=edge-tts
TTS_VOICE=zh-CN-YunxiNeural
VOLC_TTS_VOICE_TYPE=BV001_streaming
VOLC_TTS_CLUSTER=volcano_tts

# ----------------- 4. 存储与录音切片策略 -----------------
DATA_DIR=./omni_data
MAX_SLICE_SECONDS=300
MIN_SILENCE_CUT_SECONDS=120
SILENCE_DURATION_SECONDS=3.0
